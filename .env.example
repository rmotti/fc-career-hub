# Backend API base URL.
#
# Recommended: leave as the same-origin path "/api". API calls are then proxied
# through this app's own origin — the Vercel rewrite in production (vercel.json)
# and the Vite dev proxy locally (vite.config.ts) forward "/api/*" to the real
# backend. This keeps the httpOnly session cookie first-party so Safari ITP and
# other third-party-cookie restrictions don't drop it.
#
# Escape hatch: set an absolute URL (e.g. https://api.example.com) to call the
# backend directly with no same-origin proxy. The session cookie is then
# cross-site and subject to ITP. The "/api" suffix is appended if missing.
#
# Copy this file to .env.local and adjust if needed.
VITE_API_URL=/api

# Backend the Vite dev proxy forwards "/api" to. Override to point dev at a local
# backend, e.g. DEV_API_PROXY_TARGET=http://localhost:3000
# DEV_API_PROXY_TARGET=https://ample-love-production.up.railway.app
